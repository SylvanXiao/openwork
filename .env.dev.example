# Local development defaults for the Den stack.
# Copy to `.env.dev` (git-ignored) and adjust for your machine:
#   cp .env.dev.example .env.dev
# Real environment variables always take precedence over these values.
# These are throwaway local-only secrets — never use them in production.
OPENWORK_DEV_MODE=1
DATABASE_URL=mysql://root:password@127.0.0.1:3306/openwork_den
DATABASE_REDIS_URL=redis://127.0.0.1:6379
DEN_DB_ENCRYPTION_KEY=replace-with-a-local-dev-key
BETTER_AUTH_SECRET=replace-with-a-local-dev-secret
INFERENCE_ADMIN_TOKEN=replace-with-a-local-dev-token
INFERENCE_WEBHOOK_SECRET=replace-with-a-local-dev-secret
PROVISIONER_MODE=stub
